{
  "name": "legisflow",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "lerna run dev --parallel",
    "dev:web": "lerna run dev --scope @legisflow/web",
    "dev:web:mock": "lerna run dev --scope @legisflow/web",
    "dev:api": "docker compose up api postgres ollama",
    "build": "lerna run build",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "db:migrate": "docker compose exec api alembic upgrade head",
    "db:seed": "docker compose exec api python -m app.scripts.seed",
    "lint": "lerna run lint"
  },
  "devDependencies": {
    "lerna": "^8.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
